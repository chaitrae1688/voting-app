
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(
            name: 'APP_SOURCE_REPO',
            defaultValue: 'https://github.com/chaitrae1688/voting-app.git',
            description: 'Git repository containing vote, result and worker application source'
        )
        string(
            name: 'APP_BRANCH',
            defaultValue: 'main',
            description: 'Application source branch'
        )
        booleanParam(
            name: 'DEPLOY_TO_EKS',
            defaultValue: true,
            description: 'Deploy application to EKS'
        )
    }

    environment {
        AWS_REGION       = 'ap-south-1'
        EKS_CLUSTER_NAME = 'k8s'
        ECR_PREFIX       = 'votingapp'
        K8S_NAMESPACE    = 'votingapp'
        APP_DIR          = 'app'
        KUBECONFIG       = "${WORKSPACE}/.kube/eks-config"
        SONAR_HOST_URL   = 'http://3.108.217.137:9000'

        // Keep these in sync with your Kubernetes manifests.
        DB_SECRET_NAME   = 'postgres-secret'
        DB_SECRET_KEY    = 'POSTGRES_PASSWORD'
    }

    stages {

        stage('Checkout Pipeline Repository') {
            steps {
                checkout scm

                sh '''
                    echo "Pipeline repository:"
                    pwd
                    ls -la
                '''
            }
        }

        stage('Preflight Checks') {
            steps {
                sh '''
                    set -eu

                    echo "Checking required tools..."

                    command -v aws
                    command -v docker
                    command -v kubectl
                    command -v git
                    command -v curl

                    echo "AWS identity:"
                    aws sts get-caller-identity

                    echo "Docker version:"
                    docker version

                    echo "kubectl version:"
                    kubectl version --client

                    echo "Checking SonarQube..."
                    curl --fail --silent \
                        "${SONAR_HOST_URL}/api/system/status"
                    
                    echo
                    echo "Preflight checks completed."
                '''
            }
        }

        stage('Checkout Application') {
            steps {
                dir("${APP_DIR}") {
                    deleteDir()

                    git branch: "${APP_BRANCH}",
                        url: "${APP_SOURCE_REPO}"
                }

                sh '''
                    set -eu

                    echo "Application files:"
                    find app -maxdepth 3 -type f | sort

                    for component in vote result worker
                    do
                        if [ ! -f "app/${component}/Dockerfile" ]; then
                            echo "ERROR: Missing app/${component}/Dockerfile"
                            exit 1
                        fi
                    done

                    # Verify the expected application entry-point files.
                    for file in \
                        app/vote/app.py \
                        app/result/package.json \
                        app/result/server.js \
                        app/worker/package.json \
                        app/worker/worker.js
                    do
                        if [ ! -f "$file" ]; then
                            echo "ERROR: Missing application source file: $file"
                            exit 1
                        fi
                    done

                    echo "Application source validation successful."
                '''
            }
        }

        stage('Prepare ECR') {
            steps {
                script {
                    env.AWS_ACCOUNT_ID = sh(
                        script: 'aws sts get-caller-identity --query Account --output text',
                        returnStdout: true
                    ).trim()

                    env.ECR_REGISTRY =
                        "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"

                    env.IMAGE_TAG = "build-${env.BUILD_NUMBER}"
                }

                sh '''
                    set -eu

                    echo "Logging in to ECR..."

                    aws ecr get-login-password \
                        --region "$AWS_REGION" |
                    docker login \
                        --username AWS \
                        --password-stdin "$ECR_REGISTRY"

                    for component in vote result worker
                    do
                        repository="${ECR_PREFIX}-${component}"

                        if ! aws ecr describe-repositories \
                            --repository-names "$repository" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then
                            aws ecr create-repository \
                                --repository-name "$repository" \
                                --region "$AWS_REGION"
                        fi
                    done

                    echo "ECR repositories are ready."
                '''
            }
        }

        stage('Build and Push Docker Images') {
            steps {
                sh '''
                    set -eu

                    docker buildx create \
                        --name votingapp-builder \
                        --driver docker-container \
                        --use 2>/dev/null || \
                    docker buildx use votingapp-builder

                    docker buildx inspect --bootstrap

                    for component in vote result worker
                    do
                        echo "Building ${component} image..."

                        docker buildx build \
                            --platform linux/amd64 \
                            --file "app/${component}/Dockerfile" \
                            --tag "${ECR_REGISTRY}/${ECR_PREFIX}-${component}:${IMAGE_TAG}" \
                            --push \
                            "app/${component}"
                    done

                    echo "All images pushed successfully."
                '''
            }
        }

        stage('Configure EKS') {
            when {
                expression { params.DEPLOY_TO_EKS }
            }
            steps {
                sh '''
                    set -eu

                    mkdir -p "$(dirname "$KUBECONFIG")"

                    aws eks update-kubeconfig \
                        --region "$AWS_REGION" \
                        --name "$EKS_CLUSTER_NAME" \
                        --kubeconfig "$KUBECONFIG"

                    kubectl --kubeconfig "$KUBECONFIG" \
                        get nodes

                    echo "EKS connection successful."
                '''
            }
        }

        stage('Create Namespace and Database Secret') {
            when {
                expression { params.DEPLOY_TO_EKS }
            }
            steps {
                withCredentials([
                    string(
                        credentialsId: 'postgres-db-password',
                        variable: 'DB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        kubectl --kubeconfig "$KUBECONFIG" \
                            apply -f kubernetes/eks/00-namespace.yaml

                        kubectl --kubeconfig "$KUBECONFIG" \
                            create secret generic "$DB_SECRET_NAME" \
                            --namespace "$K8S_NAMESPACE" \
                            --from-literal="${DB_SECRET_KEY}=${DB_PASSWORD}" \
                            --dry-run=client -o yaml |
                        kubectl --kubeconfig "$KUBECONFIG" \
                            apply -f -

                        echo "Namespace and database secret are ready."
                    '''
                }
            }
        }

        stage('Deploy to EKS') {
            when {
                expression { params.DEPLOY_TO_EKS }
            }
            steps {
                sh '''
                    set -eu

                    echo "Applying Kubernetes manifests..."

                    for manifest in \
                        01-postgres.yaml \
                        02-redis.yaml \
                        03-vote.yaml \
                        04-result.yaml \
                        05-worker.yaml
                    do
                        kubectl --kubeconfig "$KUBECONFIG" \
                            apply -f "kubernetes/eks/$manifest" \
                            --namespace "$K8S_NAMESPACE"
                    done

                    echo "Updating application images..."

                    kubectl --kubeconfig "$KUBECONFIG" \
                        set image deployment/voting-app-deploy \
                        vote="${ECR_REGISTRY}/${ECR_PREFIX}-vote:${IMAGE_TAG}" \
                        -n "$K8S_NAMESPACE"

                    kubectl --kubeconfig "$KUBECONFIG" \
                        set image deployment/result-app-deploy \
                        result="${ECR_REGISTRY}/${ECR_PREFIX}-result:${IMAGE_TAG}" \
                        -n "$K8S_NAMESPACE"

                    kubectl --kubeconfig "$KUBECONFIG" \
                        set image deployment/worker-deploy \
                        worker="${ECR_REGISTRY}/${ECR_PREFIX}-worker:${IMAGE_TAG}" \
                        -n "$K8S_NAMESPACE"

                    echo "Deployment manifests applied."
                '''
            }
        }

        stage('Verify Deployment') {
            when {
                expression { params.DEPLOY_TO_EKS }
            }
            steps {
                sh '''
                    set -eu

                    for deployment in \
                        postgres-deploy \
                        redis-deploy \
                        voting-app-deploy \
                        result-app-deploy \
                        worker-deploy
                    do
                        echo "Checking ${deployment}..."

                        kubectl --kubeconfig "$KUBECONFIG" \
                            rollout status "deployment/${deployment}" \
                            --namespace "$K8S_NAMESPACE" \
                            --timeout=300s
                    done

                    echo "Pods:"
                    kubectl --kubeconfig "$KUBECONFIG" \
                        get pods -n "$K8S_NAMESPACE"

                    echo "Services:"
                    kubectl --kubeconfig "$KUBECONFIG" \
                        get services -n "$K8S_NAMESPACE"
                '''
            }
        }
    }

    post {
        success {
            echo 'Voting App pipeline completed successfully.'
            echo "Image tag: ${env.IMAGE_TAG}"
        }

        failure {
            echo 'Voting App pipeline failed. Check the failed stage and console output.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
